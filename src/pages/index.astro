---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import WordMorph from '../components/WordMorph.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import { site } from '../site.config';

const modules: { icon: IconName; title: string; text: string; tag: string }[] = [
  { icon: 'mail', title: 'Mail', text: 'Persönliche und geteilte Postfächer mit Zuständigkeiten, Vorlagen und Volltextsuche.', tag: 'IMAP · SMTP · JMAP' },
  { icon: 'calendar', title: 'Kalender & Kontakte', text: 'Team-Kalender, Raum- und Gerätebuchung, freie Slots für externe Terminbuchung.', tag: 'CalDAV · CardDAV' },
  { icon: 'chat', title: 'Chat', text: 'Räume pro Projekt, Team oder Kunde. Threads, Sprachnachrichten und Videocalls.', tag: 'Matrix' },
  { icon: 'files', title: 'Dateien', text: 'Ablage mit Versionen, gemeinsames Bearbeiten und Freigabelinks mit Ablaufdatum.', tag: 'WebDAV' },
  { icon: 'agent', title: 'Agents', text: 'KI-Assistenten, die in Mail, Kalender und Chat mitarbeiten – mit Freigabe für jeden Schritt nach außen.', tag: 'MCP' },
  { icon: 'plus', title: 'NN', text: 'Das Tool deiner Wahl kann einfach dazugebaut werden – mit einem Login für alles.', tag: 'OAuth2 · LDAP · SAML' },
];

const internal = [
  'Mails, Termine und Dateien eines Projekts liegen am selben Ort wie die Unterhaltung dazu.',
  'Geteilte Postfächer wie info@ oder buchhaltung@ mit Zuständigkeit statt CC-Ketten.',
  'Rollen und Rechte einmal festlegen – sie gelten in jedem Modul.',
];
const external = [
  'Gastzugang mit Ablaufdatum: Gäste sehen nur den einen Raum, nie den Rest.',
  'Wer lieber mailt, mailt – Antworten landen trotzdem im Raum.',
  'Föderierter Chat: Partner mit eigenem Matrix-Server verbinden sich direkt.',
];

const agentFacts = [
  { title: 'Modell frei wählbar', text: 'Lokal auf eigener Hardware oder bei einem EU-Anbieter deiner Wahl.' },
  { title: 'Offene Schnittstelle', text: 'Eigene Tools per MCP anbinden – ERP, Shop, Buchhaltung.' },
  { title: 'Lückenloses Protokoll', text: 'Jede Aktion nachvollziehbar: wer, wann, mit welchen Daten.' },
  { title: 'Keine Trainingsdaten', text: 'Deine Inhalte bleiben deine Inhalte.' },
];

const agentSteps = [
  { text: 'Mail-Verlauf „Angebot Fassade“ gelesen und zusammengefasst', done: true },
  { text: 'Preise aus dem Angebot V1 mit neuen Maßen abgeglichen', done: true },
  { text: 'Angebot V2 als PDF im Raum abgelegt', done: true },
  { text: 'Antwortmail an Holzwerk Brandl vorbereitet', done: false },
];

const principles = [
  { title: 'Unabhängig von US-Tech', text: 'Keine Abhängigkeit von Microsoft, Google, Amazon oder Slack – keine plötzlichen Lizenzänderungen, Preiserhöhungen, erzwungenen Cloud-Umstellungen oder über Nacht geänderten Bedingungen.' },
  { title: 'Quellcode offen', text: `Jede Zeile einsehbar und prüfbar. Weiterentwickelt mit der Community.` },
  { title: 'Dein Server, deine Daten', text: 'Per Docker oder Helm-Chart auf eigener Hardware – oder gehostet in einem Rechenzentrum in der EU.' },
  { title: 'Standards statt Lock-in', text: 'IMAP, CalDAV, CardDAV, WebDAV und Matrix. Umziehen kannst du jederzeit – mit allen Daten.' },
];
---
<Base>
  <!-- HERO -->
  <section class="container hero">
    <WordMorph class="hero__morph" />
    <div class="hero__copy">
      <ul class="pills mono" aria-label="Eigenschaften">
        <li>Open Source</li>
        <li>Hosting in der EU oder bei dir</li>
      </ul>
      <h1 class="hero__title">Ein Arbeitsplatz für dein Team. Und für alle, mit denen es arbeitet.</h1>
      <p class="lead hero__lead">CoBox bündelt Mail, Kalender, Chat, Dateien und KI-Agents in einer offenen Plattform für kleine und mittlere Unternehmen, Vereine und NGOs – intern wie mit Kund:innen, Mitgliedern und Partnern.</p>
      <div class="actions">
        <a class="btn btn--accent btn--lg" href={site.contactHref}>Demo anfragen</a>
        <a class="btn btn--outline btn--lg" href={site.githubHref}><Icon name="code" size={20} />Quellcode ansehen</a>
      </div>
    </div>

    <div class="preview" aria-hidden="true">
      <div class="preview__shadow"></div>
      <div class="preview__box">
        <div class="preview__rail">
          <Logo size={30} variant="dark" wordmark={false} />
          <Icon name="mail" size={22} />
          <Icon name="calendar" size={22} />
          <Icon name="chat" size={22} class="is-active" />
          <Icon name="files" size={22} />
          <Icon name="agent" size={22} />
        </div>
        <div class="preview__main">
          <div class="preview__head">
            <span class="preview__room"># holzwerk-brandl-relaunch</span>
            <span class="tag tag--ext mono">2 Gäste extern</span>
          </div>
          <div class="preview__msg">
            <span class="preview__avatar"></span>
            <p>Hab die neuen Entwürfe angehängt. Passt Donnerstag für die Abnahme?</p>
          </div>
          <div class="preview__mail">
            <Icon name="mail" size={18} />
            <span>Mail: „Angebot Fassade – Rückfrage“ in den Raum geholt</span>
          </div>
          <div class="preview__agent">
            <span class="preview__status mono"><span class="dot"></span>Agent · wartet auf Freigabe</span>
            <p>Termin „Abnahme Entwürfe“ Do 10:00 für 3 Personen anlegen und Einladung an beide Gäste senden?</p>
            <div class="preview__btns"><span class="chip chip--accent">Freigeben</span><span class="chip">Ändern</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MODULES -->
  <section id="module" class="band band--carton">
    <div class="container section">
      <div class="section__head">
        <h2 class="h2">Eine Box. Ein Login. Alle Werkzeuge.</h2>
        <p class="lead section__aside">Jedes Modul spricht offene Standards – deine Leute behalten ihre gewohnten Apps auf Handy und Desktop.</p>
      </div>
      <ul class="modules">
        {modules.map((m) => (
          <li class="module">
            <span class="module__icon"><Icon name={m.icon} /></span>
            <h3 class="module__title">{m.title}</h3>
            <p class="module__text">{m.text}</p>
            <span class="module__tag mono">{m.tag}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- INTERN / EXTERN -->
  <section class="container section">
    <h2 class="h2 narrow">Alle gemeinsam im selben Raum</h2>
    <div class="split">
      <article class="side side--int">
        <span class="side__label mono"><span class="sq"></span>INTERN</span>
        <h3 class="side__title">Das Team arbeitet in Räumen, nicht in Postfächern.</h3>
        <ul class="checks">
          {internal.map((t) => <li><Icon name="check" size={20} strokeWidth={2} />{t}</li>)}
        </ul>
      </article>
      <article class="side side--ext">
        <span class="side__label mono"><span class="ci"></span>EXTERN</span>
        <h3 class="side__title">Kund:innen, Mitglieder und Partner kommen per Link dazu.</h3>
        <ul class="checks">
          {external.map((t) => <li><Icon name="check" size={20} strokeWidth={2} />{t}</li>)}
        </ul>
      </article>
    </div>
  </section>

  <!-- AGENTS -->
  <section id="agents" class="band band--dark">
    <div class="container section agents">
      <div class="agents__copy">
        <span class="eyebrow mono">AGENTS</span>
        <h2 class="h2">Agents, die mitarbeiten – und fragen, bevor sie handeln.</h2>
        <p class="lead lead--dark">Agents lesen mit, fassen zusammen, entwerfen Antworten und planen Termine – mit genau den Rechten der Person, die sie startet. Alles, was nach außen geht, braucht deine Freigabe.</p>
        <dl class="facts">
          {agentFacts.map((f) => (
            <div class="fact"><dt>{f.title}</dt><dd>{f.text}</dd></div>
          ))}
        </dl>
      </div>

      <figure class="run" aria-label="Beispiel: Ablauf eines Agents">
        <div class="run__head">
          <span class="run__icon"><Icon name="agent" size={22} strokeWidth={1.9} /></span>
          <div>
            <div class="run__name">Angebots-Agent</div>
            <div class="run__meta">gestartet von Lena · im Raum #holzwerk-brandl</div>
          </div>
        </div>
        <ol class="steps">
          {agentSteps.map((s, i) => (
            <li class="step">
              <span class="step__n mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="step__text">{s.text}</span>
              <span class:list={['badge mono', s.done ? 'badge--done' : 'badge--wait']}>{s.done ? 'erledigt' : 'Freigabe'}</span>
            </li>
          ))}
        </ol>
        <div class="run__approve">
          <p>Entwurf an <strong>m.brandl@holzwerk-brandl.at</strong> – Angebot Fassade, Version 2 als PDF angehängt.</p>
          <div class="preview__btns" aria-hidden="true">
            <span class="chip chip--accent chip--lg">Freigeben und senden</span>
            <span class="chip chip--dark chip--lg">Entwurf öffnen</span>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- OPEN SOURCE -->
  <section id="opensource" class="container section">
    <div class="section__head">
      <h2 class="h2 narrow">Offen gebaut. Damit du nie festsitzt.</h2>
      <a class="text-link" href={site.githubHref}>Zum Repository</a>
    </div>
    <ol class="principles">
      {principles.map((p, i) => (
        <li class="principle">
          <span class="principle__n">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="principle__title">{p.title.split(" ").map((w, j) => <>{j > 0 && " "}<span class="nowrap">{w}</span></>)}</h3>
          <p class="principle__text">{p.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- PRICING -->
  <section id="preise" class="band band--carton">
    <div class="container section">
      <h2 class="h2">Selbst betreiben oder betreiben lassen.</h2>
      <div class="plans">
        <article class="plan">
          <span class="mono plan__label">COMMUNITY</span>
          <p class="plan__price">Kostenlos</p>
          <p class="plan__text">Alle Module, selbst gehostet. Hilfe über Forum und Dokumentation.</p>
          <a class="btn btn--outline plan__cta" href={site.installHref}>Installationsanleitung</a>
        </article>
        <article class="plan plan--featured">
          <span class="mono plan__label plan__label--accent">COBOX CLOUD</span>
          {site.priceCloud
            ? <p class="plan__price">{site.priceCloud} <span class="plan__unit">pro Person / Monat</span></p>
            : <p class="plan__price plan__price--tbd">Preis folgt</p>}
          <p class="plan__text">Wir betreiben, sichern und aktualisieren. Hosting in der EU, Gäste kostenlos.</p>
          <a class="btn btn--accent plan__cta" href={site.contactHref}>Demo anfragen</a>
        </article>
        <article class="plan">
          <span class="mono plan__label">SUPPORT</span>
          <p class:list={['plan__price', !site.priceSupport && 'plan__price--tbd']}>{site.priceSupport ?? 'Preis folgt'}</p>
          <p class="plan__text">Für den Eigenbetrieb: Einrichtung, Migration bestehender Postfächer und garantierte Reaktionszeiten.</p>
          <a class="btn btn--outline plan__cta" href={site.contactHref}>Kontakt aufnehmen</a>
        </article>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section id="demo" class="container section">
    <div class="cta">
      <h2 class="cta__title">Eine Box für alles. Ab nächster Woche.</h2>
      <a class="btn btn--ink btn--lg" href={site.contactHref}>Demo anfragen <Icon name="arrow" size={20} strokeWidth={2} /></a>
    </div>
  </section>
</Base>

<style>
  .section { padding-block: var(--section); display: flex; flex-direction: column; gap: 48px; }
  .section__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px; }
  .section__head .h2 { max-width: 680px; }
  .section__aside { max-width: 420px; }
  .narrow { max-width: 820px; }
  .band--carton { background: var(--carton); border-top: 1px solid var(--line); }
  .band--dark { background: var(--surface-dark); color: var(--on-dark-strong); }

  /* Hero */
  .hero {
    padding-block: clamp(48px, 7vw, 80px) clamp(72px, 9vw, 96px);
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(460px, 100%), 1fr));
    gap: 64px; align-items: center;
  }
  .hero :global(.hero__morph) { grid-column: 1 / -1; margin-bottom: -16px; }
  .hero__copy { display: flex; flex-direction: column; gap: 28px; }
  .pills { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; font-size: 13px; }
  .pills li { padding: 6px 10px; border: 1px solid var(--rule-strong); border-radius: 999px; }
  .hero__title {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(32px, 4.2vw, 54px); line-height: 1.04; letter-spacing: -0.03em; text-wrap: balance;
  }
  .hero__lead { font-size: clamp(18px, 1.6vw, 20px); max-width: 540px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }

  .preview { position: relative; }
  .preview__shadow { position: absolute; inset: 24px -16px -24px 24px; background: var(--accent); border-radius: 22px; }
  @media (max-width: 600px) { .preview__shadow { inset: 14px -6px -14px 14px; } }
  .preview__box {
    position: relative; display: flex; min-height: 440px; overflow: hidden;
    background: var(--white); border: 1.5px solid var(--rule-strong); border-radius: 22px;
  }
  .preview__rail {
    width: 64px; flex-shrink: 0; background: var(--surface-dark); color: var(--on-dark-muted);
    display: flex; flex-direction: column; align-items: center; gap: 18px; padding: 20px 0;
  }
  .preview__rail :global(.is-active) { color: var(--on-dark-strong); }
  .preview__main { flex: 1; min-width: 0; padding: 22px; display: flex; flex-direction: column; gap: 14px; font-size: 13px; line-height: 1.45; }
  .preview__head { display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; }
  .preview__room { font-family: var(--font-display); font-weight: 600; font-size: 17px; }
  .tag { font-size: 11px; padding: 4px 8px; border-radius: 6px; }
  .tag--ext { background: var(--ext-light); color: var(--ext); }
  .preview__msg { display: flex; gap: 10px; align-items: flex-start; }
  .preview__msg p { background: var(--paper); border-radius: 4px 12px 12px 12px; padding: 10px 12px; }
  .preview__avatar { width: 30px; height: 30px; border-radius: 8px; background: var(--carton); flex-shrink: 0; }
  .preview__mail { border: 1px solid var(--line); border-radius: 12px; padding: 12px; display: flex; gap: 10px; align-items: center; }
  .preview__mail span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .preview__agent { margin-top: auto; background: var(--surface-dark); color: var(--on-dark-strong); border-radius: 14px; padding: 14px; display: flex; flex-direction: column; gap: 10px; }
  .preview__status { display: flex; align-items: center; gap: 8px; font-size: 11px; color: var(--on-dark-muted); }
  .dot { width: 8px; height: 8px; border-radius: 99px; background: var(--accent); }
  .preview__btns { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { font-size: 12px; font-weight: 500; padding: 7px 12px; border-radius: 8px; border: 1px solid #4a4d55; }
  .chip--accent { background: var(--accent); border-color: var(--accent); color: var(--on-accent); font-weight: 600; }
  .chip--lg { font-size: 15px; padding: 12px 18px; border-radius: 10px; }
  .chip--dark { color: var(--on-dark-strong); }

  /* Modules */
  .modules {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
    gap: 2px; background: var(--rule-strong); border: 2px solid var(--rule-strong); border-radius: 20px; overflow: hidden;
  }
  .module { background: var(--paper); padding: 32px; display: flex; flex-direction: column; gap: 14px; min-height: 240px; }
  .module__icon { width: 48px; height: 48px; border-radius: 12px; background: var(--surface-dark); color: var(--on-dark-strong); display: flex; align-items: center; justify-content: center; }
  .module__title { font-family: var(--font-display); font-weight: 600; font-size: 24px; letter-spacing: -0.01em; }
  .module__text { color: var(--muted); line-height: 1.55; }
  .module__tag { margin-top: auto; font-size: 12px; color: var(--muted); }

  /* Intern / Extern */
  .split { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(460px, 100%), 1fr)); gap: 24px; }
  .side { border: 1.5px solid var(--rule-strong); border-radius: 20px; padding: clamp(24px, 4vw, 36px); display: flex; flex-direction: column; gap: 20px; background: var(--white); }
  .side--ext { border-color: var(--ext); background: var(--ext-light); color: var(--ext-deep); }
  .side__label { font-size: 13px; font-weight: 500; display: flex; align-items: center; gap: 8px; }
  .side--ext .side__label { color: var(--ext); }
  .sq, .ci { width: 10px; height: 10px; background: var(--ink); border-radius: 3px; }
  .ci { background: var(--ext); border-radius: 99px; }
  .side__title { font-family: var(--font-display); font-weight: 600; font-size: clamp(22px, 2.4vw, 28px); letter-spacing: -0.015em; line-height: 1.2; }
  .checks { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; color: var(--ink-2); }
  .side--ext .checks { color: var(--ext-deep); }
  .checks li { display: flex; gap: 12px; }
  .checks :global(svg) { flex-shrink: 0; margin-top: 2px; }

  /* Agents */
  .agents { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(460px, 100%), 1fr)); gap: 64px; align-items: center; }
  .agents__copy { display: flex; flex-direction: column; gap: 24px; }
  .eyebrow { font-size: 13px; color: var(--accent); }
  .lead--dark { color: var(--on-dark); max-width: 520px; }
  .facts { margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); gap: 16px; }
  .fact { border-top: 1px solid var(--dark-line); padding-top: 16px; display: flex; flex-direction: column; gap: 6px; }
  .fact dt { font-weight: 600; }
  .fact dd { margin: 0; font-size: 15px; color: var(--on-dark-muted); }

  .run { margin: 0; background: var(--dark-2); border: 1px solid var(--dark-line); border-radius: 20px; padding: clamp(20px, 3vw, 28px); display: flex; flex-direction: column; gap: 18px; }
  .run__head { display: flex; align-items: center; gap: 12px; }
  .run__icon { width: 40px; height: 40px; border-radius: 10px; background: var(--accent); color: var(--on-accent); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .run__name { font-weight: 600; }
  .run__meta { font-size: 13px; color: var(--on-dark-muted); }
  .steps { list-style: none; margin: 0; padding: 0; }
  .step { display: flex; gap: 14px; align-items: flex-start; padding: 12px 0; border-bottom: 1px solid var(--dark-rule); }
  .step__n { font-size: 12px; color: var(--on-dark-muted); width: 22px; padding-top: 2px; }
  .step__text { flex: 1; font-size: 15px; line-height: 1.45; }
  .badge { font-size: 11px; padding: 4px 8px; border-radius: 6px; white-space: nowrap; }
  .badge--done { background: var(--done-bg); color: var(--done-fg); }
  .badge--wait { background: var(--accent); color: var(--on-accent); }
  .run__approve { background: var(--surface-dark); border: 1px solid var(--dark-line); border-radius: 14px; padding: 18px; display: flex; flex-direction: column; gap: 14px; font-size: 14px; color: var(--on-dark); }
  .run__approve strong { color: var(--on-dark-strong); word-break: break-all; }

  /* Open source */
  .text-link { font-weight: 600; text-underline-offset: 4px; min-height: 44px; display: inline-flex; align-items: center; }
  .principles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr)); gap: 40px 32px; }
  .principle { display: flex; flex-direction: column; gap: 14px; }
  .principle__n { font-family: var(--font-display); font-weight: 700; font-size: 64px; line-height: 1; color: var(--accent-text); }
  .principle__title { font-family: var(--font-display); font-weight: 600; font-size: 24px; }
  .nowrap { white-space: nowrap; }
  .principle__text { color: var(--muted); line-height: 1.55; }

  /* Pricing */
  .plans { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: 20px; }
  .plan { background: var(--paper); border: 1.5px solid var(--rule-strong); border-radius: 20px; padding: 32px; display: flex; flex-direction: column; gap: 18px; }
  .plan--featured { background: var(--surface-dark); color: var(--on-dark-strong); border-color: var(--surface-dark); }
  .plan__label { font-size: 13px; }
  .plan__label--accent { color: var(--accent); }
  .plan__price { font-family: var(--font-display); font-weight: 700; font-size: 44px; letter-spacing: -0.02em; line-height: 1.1; }
  .plan__price--tbd { opacity: 0.55; }
  .plan__unit { font-size: 18px; font-weight: 500; color: var(--on-dark); letter-spacing: 0; }
  .plan__text { color: var(--muted); }
  .plan--featured .plan__text { color: var(--on-dark); }
  .plan__cta { margin-top: auto; }

  /* CTA */
  .cta {
    background: var(--accent); color: var(--on-accent); border: 2px solid var(--on-accent); border-radius: 28px;
    padding: clamp(32px, 6vw, 72px);
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 32px;
  }
  .cta .btn--ink { background: var(--on-accent); color: var(--on-dark-strong); }
  .cta__title { font-family: var(--font-display); font-weight: 700; font-size: clamp(32px, 4.4vw, 60px); line-height: 1; letter-spacing: -0.035em; max-width: 680px; text-wrap: balance; }
</style>
