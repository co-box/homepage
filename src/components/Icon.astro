---
export type IconName =
  | 'mail' | 'calendar' | 'chat' | 'files' | 'agent' | 'link'
  | 'check' | 'code' | 'arrow' | 'plus';

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  class?: string;
}
const { name, size = 24, strokeWidth = 1.8, class: className } = Astro.props;
---
<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></>}
  {name === 'calendar' && <><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /></>}
  {name === 'chat' && <path d="M4 5h16v11H9l-5 4z" />}
  {name === 'files' && <path d="M4 4h6l2 3h8v13H4z" />}
  {name === 'agent' && <><rect x="5" y="8" width="14" height="11" rx="3" /><path d="M12 4v4" /><circle cx="9.5" cy="13.5" r="1" /><circle cx="14.5" cy="13.5" r="1" /></>}
  {name === 'link' && <><path d="M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1" /><path d="M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1" /></>}
  {name === 'check' && <path d="M5 12l5 5 9-10" />}
  {name === 'code' && <path d="M8 7l-5 5 5 5M16 7l5 5-5 5M14 4l-4 16" />}
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'plus' && <><rect x="3.5" y="3.5" width="17" height="17" rx="4" stroke-dasharray="3 2.6" /><path d="M12 8v8M8 12h8" /></>}
</svg>
