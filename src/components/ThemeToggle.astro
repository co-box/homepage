---
/**
 * Umschalter Hell/Dunkel. Ohne Klick folgt die Seite der Systemeinstellung;
 * nach einem Klick wird die Wahl im Browser gespeichert (localStorage „theme“).
 * Das Setzen beim Laden passiert früh im <head> (siehe Base.astro), damit nichts aufblitzt.
 */
---
<button type="button" class="theme-toggle" data-theme-toggle aria-label="Dunkles Design" aria-pressed="false">
  <svg class="theme-toggle__moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />
  </svg>
  <svg class="theme-toggle__sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
</button>

<style>
  .theme-toggle {
    width: 44px; height: 44px; flex-shrink: 0;
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: 12px; border: 1.5px solid var(--line);
    background: transparent; color: var(--ink); cursor: pointer;
    transition: border-color .15s ease, background-color .15s ease;
  }
  .theme-toggle:hover { border-color: var(--ink); }
  /* Mond im hellen Modus zeigen (wechselt zu dunkel), Sonne im dunklen */
  .theme-toggle__sun { display: none; }
  :global(:root[data-theme="dark"]) .theme-toggle__sun { display: block; }
  :global(:root[data-theme="dark"]) .theme-toggle__moon { display: none; }
</style>

<script>
  const KEY = 'theme';
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  const root = document.documentElement;

  const stored = (): string | null => {
    try { return localStorage.getItem(KEY); } catch { return null; }
  };
  const current = () => root.dataset.theme === 'dark' ? 'dark' : 'light';

  function apply(theme: 'light' | 'dark') {
    root.dataset.theme = theme;
    document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]').forEach((m) => {
      m.content = theme === 'dark' ? '#111317' : '#f4f2ec';
    });
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) => {
      const dark = theme === 'dark';
      b.setAttribute('aria-pressed', String(dark));
      b.setAttribute('title', dark ? 'Zu hellem Design wechseln' : 'Zu dunklem Design wechseln');
    });
  }

  apply(current());

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) => {
    b.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      try { localStorage.setItem(KEY, next); } catch { /* privates Fenster o. Ä. */ }
      apply(next);
    });
  });

  // Ohne eigene Wahl: Systemwechsel live übernehmen
  media.addEventListener('change', (e) => {
    if (!stored()) apply(e.matches ? 'dark' : 'light');
  });
</script>
