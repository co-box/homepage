---
interface Props {
  size?: number;
  variant?: 'light' | 'dark';
  wordmark?: boolean;
  class?: string;
}
const { size = 32, variant = 'light', wordmark = true, class: className } = Astro.props;
const stroke = variant === 'dark' ? 'var(--paper)' : 'var(--ink)';
---
<span class:list={['logo', `logo--${variant}`, className]} style={`--logo-size:${size}px`}>
  <svg width={size} height={size} viewBox="0 0 40 40" aria-hidden="true">
    <path d="M30.72 11A14 14 0 1 0 30.72 29" fill="none" stroke={stroke} stroke-width="6" stroke-linecap="round" />
    <rect x="13" y="14.5" width="11" height="11" rx="3" fill="var(--accent)" />
    <circle cx="28.5" cy="20" r="2.6" fill="var(--accent)" />
  </svg>
  {wordmark && <span class="logo__word"><span class="logo__co">Co</span>Box</span>}
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: calc(var(--logo-size) * 0.3); }
  .logo__word {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: calc(var(--logo-size) * 0.74);
    letter-spacing: -0.025em;
    line-height: 1;
    color: var(--ink);
  }
  .logo--dark .logo__word { color: var(--paper); }
  .logo__co { color: var(--accent); }
</style>
